{
  "name": "llama-chatbot",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    },
    "codespaces": {
      "openFiles": ["README.md", "frontend/streamlit.py"]
    }
  },
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "openPreview"
    },
    "8501": {
      "label": "Streamlit",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install -r /app/requirements.txt",
  "postAttachCommand": "uvicorn backend.app:app --host 0.0.0.0 --port 8000 & streamlit run frontend/streamlit.py"
}

